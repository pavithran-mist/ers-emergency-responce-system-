# Copy to .env.production on the server. Never commit the completed file.
DOMAIN=astra.example.com
CADDY_EMAIL=you@example.com
POSTGRES_DB=astra_ai
POSTGRES_USER=astra_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-strong-password
DEFAULT_ADMIN_NAME="ASTRA Administrator"
CORS_ORIGINS=https://astra.example.com
ASTRA_SYNTHETIC_FPS=30
ASTRA_USE_CUDA=false
