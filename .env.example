# ASTRA AI Environment Variables Example
APP_NAME="ASTRA AI"
APP_ENV=development

# Performance
# Demo cameras are capped at this rate. Use 60 only on a machine that can sustain it.
ASTRA_SYNTHETIC_FPS=30
# Set true only when PyTorch detects a supported NVIDIA CUDA GPU.
ASTRA_USE_CUDA=false

# JWT Secret Key
JWT_SECRET=astra-ai-super-secure-secret-key-2026-road-safety
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./astra_ai.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra_ai

# Default Super Administrator Account Seed
DEFAULT_ADMIN_EMAIL=admin@astra.ai
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME="System Administrator"

# Model Paths
MODELS_DIR=models
ACCIDENT_MODEL_PATH=models/road_accident.pt
FIRE_MODEL_PATH=models/fire_detection.pt
